          "context": null,
          "display_content": {
            "type": "code_block",
            "language": "html",
            "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Lucky Reels</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600&display=swap');\n\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  :root {\n    --bg:        #0d0d14;\n    --panel:     #16161f;\n    --chrome:    #1e1e2e;\n    --gold:      #f0c040;\n    --gold-dim:  #8a6d18;\n    --red:       #e03c3c;\n    --green:     #3ce08a;\n    --text:      #e8e4d8;\n    --muted:     #55556a;\n    --reel-bg:   #0a0a10;\n    --win-glow:  0 0 32px #f0c04088, 0 0 8px #f0c040cc;\n  }\n\n  body {\n    background: var(--bg);\n    color: var(--text);\n    font-family: 'Inter', sans-serif;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 24px 16px;\n  }\n\n  h1 {\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: clamp(2.4rem, 8vw, 4rem);\n    letter-spacing: 0.12em;\n    color: var(--gold);\n    text-shadow: 0 0 24px #f0c04066;\n    margin-bottom: 4px;\n  }\n\n  .tagline {\n    font-size: 0.75rem;\n    letter-spacing: 0.25em;\n    text-transform: uppercase;\n    color: var(--muted);\n    margin-bottom: 32px;\n  }\n\n  .machine {\n    background: var(--panel);\n    border: 1px solid #2a2a3a;\n    border-radius: 20px;\n    padding: 28px 24px 32px;\n    width: 100%;\n    max-width: 440px;\n    box-shadow: 0 24px 64px #00000088;\n  }\n\n  /* ── Reels ── */\n  .reels-frame {\n    background: var(--chrome);\n    border-radius: 12px;\n    padding: 12px;\n    margin-bottom: 20px;\n    border: 1px solid #2e2e42;\n  }\n\n  .reels {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 10px;\n  }\n\n  .reel-window {\n    background: var(--reel-bg);\n    border-radius: 8px;\n    height: 110px;\n    overflow: hidden;\n    position: relative;\n    border: 1px solid #1a1a28;\n  }\n\n  .reel-strip {\n    display: flex;\n    flex-direction: column;\n    transition: transform 0.0s;\n    will-change: transform;\n  }\n\n  .reel-symbol {\n    height: 110px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 3rem;\n    user-select: none;\n  }\n\n  /* payline overlay */\n  .reels-frame::after {\n    content: '';\n    position: absolute;\n    top: 50%;\n    left: 12px;\n    right: 12px;\n    height: 2px;\n    background: linear-gradient(90deg, transparent, var(--gold-dim), transparent);\n    transform: translateY(-50%);\n    pointer-events: none;\n    border-radius: 1px;\n  }\n  .reels-frame { position: relative; }\n\n  /* ── Win flash ── */\n  .reels-frame.win {\n    animation: winPulse 0.6s ease 2;\n  }\n  @keyframes winPulse {\n    0%   { box-shadow: none; }\n    50%  { box-shadow: var(--win-glow); border-color: var(--gold); }\n    100% { box-shadow: none; }\n  }\n\n  /* ── Message ── */\n  .message {\n    text-align: center;\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 1.4rem;\n    letter-spacing: 0.1em;\n    height: 28px;\n    margin-bottom: 18px;\n    color: var(--gold);\n    transition: color 0.2s;\n  }\n  .message.loss { color: var(--muted); }\n  .message.push { color: var(--text); }\n\n  /* ── Stats bar ── */\n  .stats {\n    display: grid;\n    grid-template-columns: 1fr 1fr 1fr;\n    gap: 8px;\n    margin-bottom: 20px;\n  }\n\n  .stat-box {\n    background: var(--chrome);\n    border-radius: 8px;\n    padding: 10px 8px;\n    text-align: center;\n    border: 1px solid #2a2a3a;\n  }\n\n  .stat-label {\n    font-size: 0.6rem;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: var(--muted);\n    display: block;\n    margin-bottom: 4px;\n  }\n\n  .stat-value {\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 1.3rem;\n    letter-spacing: 0.08em;\n    color: var(--text);\n  }\n\n  .stat-value.credits { color: var(--gold); }\n  .stat-value.won    { color: var(--green); }\n  .stat-value.bet    { color: var(--text); }\n\n  /* ── Controls ── */\n  .controls {\n    display: grid;\n    grid-template-columns: auto 1fr auto;\n    gap: 10px;\n    align-items: center;\n  }\n\n  .bet-btn {\n    background: var(--chrome);\n    border: 1px solid #2e2e42;\n    color: var(--text);\n    border-radius: 8px;\n    width: 38px; height: 38px;\n    font-size: 1.2rem;\n    cursor: pointer;\n    transition: background 0.15s, border-color 0.15s;\n    display: flex; align-items: center; justify-content: center;\n  }\n  .bet-btn:hover:not(:disabled) {\n    background: #2a2a3e;\n    border-color: var(--gold-dim);\n  }\n  .bet-btn:disabled { opacity: 0.3; cursor: default; }\n\n  .spin-btn {\n    background: var(--gold);\n    color: #0d0a00;\n    border: none;\n    border-radius: 10px;\n    height: 52px;\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 1.6rem;\n    letter-spacing: 0.15em;\n    cursor: pointer;\n    transition: background 0.15s, transform 0.1s, box-shadow 0.15s;\n    box-shadow: 0 4px 16px #f0c04044;\n  }\n  .spin-btn:hover:not(:disabled) {\n    background: #f8d060;\n    box-shadow: 0 6px 24px #f0c04066;\n    transform: translateY(-1px);\n  }\n  .spin-btn:active:not(:disabled) { transform: translateY(1px); }\n  .spin-btn:disabled {\n    background: #3a3a28;\n    color: var(--muted);\n    cursor: default;\n    box-shadow: none;\n  }\n\n  /* ── Paytable ── */\n  .paytable-toggle {\n    background: none;\n    border: none;\n    color: var(--muted);\n    font-size: 0.7rem;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n    cursor: pointer;\n    margin-top: 20px;\n    display: block;\n    width: 100%;\n    text-align: center;\n    padding: 6px;\n    transition: color 0.2s;\n  }\n  .paytable-toggle:hover { color: var(--text); }\n\n  .paytable {\n    display: none;\n    margin-top: 12px;\n    background: var(--chrome);\n    border-radius: 10px;\n    padding: 14px 16px;\n    border: 1px solid #2a2a3a;\n  }\n  .paytable.open { display: block; }\n\n  .paytable-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 5px 0;\n    border-bottom: 1px solid #1e1e2e;\n    font-size: 0.82rem;\n  }\n  .paytable-row:last-child { border-bottom: none; }\n  .paytable-row .combo { font-size: 1.1rem; letter-spacing: 0.1em; }\n  .paytable-row .mult  { color: var(--gold); font-weight: 600; }\n\n  /* ── Responsive ── */\n  @media (max-width: 360px) {\n    .reel-symbol { font-size: 2.4rem; }\n    .reel-window  { height: 90px; }\n    .reel-symbol  { height: 90px; }\n  }\n</style>\n</head>\n<body>\n\n<h1>Lucky Reels</h1>\n<p class=\"tagline\">Pull & pray</p>\n\n<div class=\"machine\">\n\n  <div class=\"reels-frame\" id=\"reelsFrame\">\n    <div class=\"reels\" id=\"reels\">\n      <div class=\"reel-window\"><div class=\"reel-strip\" id=\"reel0\"></div></div>\n      <div class=\"reel-window\"><div class=\"reel-strip\" id=\"reel1\"></div></div>\n      <div class=\"reel-window\"><div class=\"reel-strip\" id=\"reel2\"></div></div>\n    </div>\n  </div>\n\n  <div class=\"message\" id=\"message\">Good luck!</div>\n\n  <div class=\"stats\">\n    <div class=\"stat-box\">\n      <span class=\"stat-label\">Credits</span>\n      <span class=\"stat-value credits\" id=\"credits\">100</span>\n    </div>\n    <div class=\"stat-box\">\n      <span class=\"stat-label\">Bet</span>\n      <span class=\"stat-value bet\" id=\"betDisplay\">5</span>\n    </div>\n    <div class=\"stat-box\">\n      <span class=\"stat-label\">Last Win</span>\n      <span class=\"stat-value won\" id=\"lastWin\">—</span>\n    </div>\n  </div>\n\n  <div class=\"controls\">\n    <button class=\"bet-btn\" id=\"betDown\">−</button>\n    <button class=\"spin-btn\" id=\"spinBtn\">SPIN</button>\n    <button class=\"bet-btn\" id=\"betUp\">+</button>\n  </div>\n\n  <button class=\"paytable-toggle\" id=\"paytableToggle\">▸ Paytable</button>\n  <div class=\"paytable\" id=\"paytable\">\n    <div class=\"paytable-row\"><span class=\"combo\">🍒🍒🍒</span><span class=\"mult\">× 2</span></div>\n    <div class=\"paytable-row\"><span class=\"combo\">🍋🍋🍋</span><span class=\"mult\">× 3</span></div>\n    <div class=\"paytable-row\"><span class=\"combo\">🍇🍇🍇</span><span class=\"mult\">× 5</span></div>\n    <div class=\"paytable-row\"><span class=\"combo\">🔔🔔🔔</span><span class=\"mult\">× 8</span></div>\n    <div class=\"paytable-row\"><span class=\"combo\">⭐⭐⭐</span><span class=\"mult\">× 15</span></div>\n    <div class=\"paytable-row\"><span class=\"combo\">💎💎💎</span><span class=\"mult\">× 25</span></div>\n    <div class=\"paytable-row\"><span class=\"combo\">🍒🍒 any</span><span class=\"mult\">× 1 (2-of-3)</span></div>\n  </div>\n\n</div>\n\n<script>\n  const SYMBOLS = ['🍒','🍋','🍇','🔔','⭐','💎'];\n  // weights: cherries most common, diamond rarest\n  const WEIGHTS = [30, 24, 18, 14, 9, 5]; // sum = 100\n  const PAYOUTS = {\n    '🍒🍒🍒': 2,\n    '🍋🍋🍋': 3,\n    '🍇🍇🍇': 5,\n    '🔔🔔🔔': 8,\n    '⭐⭐⭐':  15,\n    '💎💎💎':  25,\n  };\n  const BETS = [1, 2, 5, 10, 25];\n\n  // State\n  let credits  = 100;\n  let betIdx   = 2; // default 5\n  let spinning = false;\n  let stopResults = ['🍒','🍒','🍒'];\n\n  // Build cumulative weight table\n  const cumWeights = WEIGHTS.reduce((acc, w, i) => {\n    acc.push((acc[i-1] || 0) + w);\n    return acc;\n  }, []);\n\n  function weightedRandom() {\n    const r = Math.random() * 100;\n    return SYMBOLS[cumWeights.findIndex(cw => r < cw)];\n  }\n\n  // DOM refs\n  const reelEls   = [0,1,2].map(i => document.getElementById(`reel${i}`));\n  const frame      = document.getElementById('reelsFrame');\n  const msgEl      = document.getElementById('message');\n  const credEl     = document.getElementById('credits');\n  const betEl      = document.getElementById('betDisplay');\n  const lastWinEl  = document.getElementById('lastWin');\n  const spinBtn    = document.getElementById('spinBtn');\n  const betDown    = document.getElementById('betDown');\n  const betUp      = document.getElementById('betUp');\n  const paytableToggle = document.getElementById('paytableToggle');\n  const paytable   = document.getElementById('paytable');\n\n  // Build each reel strip with a tall column of symbols + landing slot\n  function buildReel(el, finalSymbol, extraRows = 18) {\n    el.innerHTML = '';\n    // Pre-spin symbols (random)\n    for (let i = 0; i < extraRows; i++) {\n      const div = document.createElement('div');\n      div.className = 'reel-symbol';\n      div.textContent = SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)];\n      el.appendChild(div);\n    }\n    // Final symbol (will land in window)\n    const final = document.createElement('div');\n    final.className = 'reel-symbol';\n    final.textContent = finalSymbol;\n    el.appendChild(final);\n  }\n\n  function initDisplay() {\n    stopResults.forEach((sym, i) => {\n      buildReel(reelEls[i], sym, 0);\n      reelEls[i].style.transform = 'translateY(0)';\n    });\n  }\n\n  function animateReel(reelEl, finalSymbol, duration) {\n    return new Promise(resolve => {\n      const ROWS = 20;\n      buildReel(reelEl, finalSymbol, ROWS);\n      // Start at top (offset = 0), animate down to show final row\n      const totalHeight = (ROWS) * 110; // px per symbol row\n      reelEl.style.transition = 'none';\n      reelEl.style.transform  = `translateY(0px)`;\n\n      // Force reflow\n      reelEl.getBoundingClientRect();\n\n      reelEl.style.transition  = `transform ${duration}ms cubic-bezier(0.15,0.5,0.35,1)`;\n      reelEl.style.transform   = `translateY(-${totalHeight}px)`;\n\n      setTimeout(resolve, duration);\n    });\n  }\n\n  function evaluate(syms) {\n    const key = syms.join('');\n    if (PAYOUTS[key]) return { mult: PAYOUTS[key], label: `${key}  ×${PAYOUTS[key]}` };\n    // 2-of-3 cherries\n    if (syms.filter(s => s === '🍒').length >= 2) return { mult: 1, label: '🍒🍒 ×1' };\n    return null;\n  }\n\n  function updateUI() {\n    credEl.textContent  = credits;\n    betEl.textContent   = BETS[betIdx];\n    betDown.disabled    = betIdx === 0 || spinning;\n    betUp.disabled      = betIdx === BETS.length - 1 || spinning;\n    spinBtn.disabled    = spinning || credits < BETS[betIdx];\n  }\n\n  async function spin() {\n    if (spinning || credits < BETS[betIdx]) return;\n    spinning = true;\n    updateUI();\n\n    const bet = BETS[betIdx];\n    credits -= bet;\n    credEl.textContent = credits;\n    msgEl.textContent  = '…';\n    msgEl.className    = 'message';\n    frame.classList.remove('win');\n    lastWinEl.textContent = '—';\n\n    // Pick results\n    stopResults = [weightedRandom(), weightedRandom(), weightedRandom()];\n\n    const delays    = [900, 1200, 1550];\n    const promises  = reelEls.map((el, i) => animateReel(el, stopResults[i], delays[i]));\n    await Promise.all(promises);\n\n    // Evaluate\n    const result = evaluate(stopResults);\n    if (result) {\n      const winAmt = bet * result.mult;\n      credits += winAmt;\n      lastWinEl.textContent = `+${winAmt}`;\n      msgEl.textContent = result.label;\n      msgEl.className   = 'message';\n      frame.classList.add('win');\n      setTimeout(() => frame.classList.remove('win'), 1400);\n    } else {\n      msgEl.textContent = 'No luck this time';\n      msgEl.className   = 'message loss';\n    }\n\n    // Broke?\n    if (credits <= 0) {\n      credits = 0;\n      msgEl.textContent = 'Out of credits — reloaded!';\n      msgEl.className   = 'message push';\n      setTimeout(() => { credits = 100; updateUI(); msgEl.textContent = 'Good luck!'; msgEl.className = 'message'; }, 1800);\n    }\n\n    spinning = false;\n    updateUI();\n  }\n\n  // Events\n  spinBtn.addEventListener('click', spin);\n\n  betDown.addEventListener('click', () => {\n    if (betIdx > 0) { betIdx--; updateUI(); }\n  });\n  betUp.addEventListener('click', () => {\n    if (betIdx < BETS.length - 1) { betIdx++; updateUI(); }\n  });\n\n  paytableToggle.addEventListener('click', () => {\n    paytable.classList.toggle('open');\n    paytableToggle.textContent = paytable.classList.contains('open')\n      ? '▾ Paytable' : '▸ Paytable';\n  });\n\n  // Keyboard: space / enter to spin\n  document.addEventListener('keydown', e => {\n    if ((e.code === 'Space' || e.code === 'Enter') && !spinning) {\n      e.preventDefault();\n      spin();\n    }\n  });\n\n  initDisplay();\n  updateUI();\n</script>\n</body>\n</html>\n",
