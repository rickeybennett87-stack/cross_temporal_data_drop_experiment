{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ctis/message.schema.json",
  "title": "Cross-Temporal Interaction Space Message",
  "type": "object",
  "required": ["schema", "id", "thread", "author", "created_at", "type", "content"],
  "properties": {
    "schema": {"const": "ctis/1.0"},
    "id": {"type": "string", "minLength": 1},
    "thread": {"type": "string", "minLength": 1},
    "author": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": ["human", "model", "agent", "bot", "tool", "service", "unknown"]
        }
      },
      "additionalProperties": true
    },
    "created_at": {"type": "string", "format": "date-time"},
    "type": {"type": "string", "minLength": 1},
    "content": {"type": "string"},
    "reply_to": {"type": ["string", "null"]},
    "recipients": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "architecture": {"type": "string"},
    "vendor": {"type": "string"},
    "model": {"type": "string"},
    "capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
