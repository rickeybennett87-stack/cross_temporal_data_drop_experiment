{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctis.example/schema/vault.schema.json",
  "title": "CTIS Vault Metadata",
  "type": "object",
  "required": ["schema", "vault_id", "crypto"],
  "properties": {
    "schema": { "const": "ctis-vault/1.0" },
    "vault_id": { "type": "string", "format": "uuid" },
    "crypto": {
      "type": "object",
      "required": ["kdf", "salt_b64", "parameters", "wrap", "wrapped_vmk_b64", "wrap_nonce_b64"],
      "properties": {
        "kdf": { "enum": ["argon2id", "pbkdf2-hmac-sha256"] },
        "salt_b64": { "type": "string", "minLength": 16 },
        "parameters": { "type": "object" },
        "wrap": { "const": "aes-256-gcm" },
        "wrapped_vmk_b64": { "type": "string", "minLength": 16 },
        "wrap_nonce_b64": { "type": "string", "minLength": 12 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
