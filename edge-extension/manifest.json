{
  "manifest_version": 3,
  "name": "CTIS Existing-Tab Bridge",
  "version": "0.3.0",
  "description": "Bridges CTIS to user-opened AI tabs, captures assistant replies from the DOM, and normalizes them into CTIS messages. Never opens tabs, navigates, logs in, or interacts with challenge/security pages.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://rickeybennett87-stack.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CTIS Existing-Tab Bridge"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
      "js": ["model-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://rickeybennett87-stack.github.io/cross_temporal_data_drop_experiment/*"],
      "js": ["ctis-content.js"],
      "run_at": "document_idle"
    }
  ]
}
